# 로컬 개발용 자격증명 샘플. 복사해서 .env 로 쓰고 실제 키를 채운다.
#   cp .env.example .env
# .env 는 .gitignore 로 제외됨. 배포 시엔 GitHub Secrets 로 주입한다.

# FRED (미국채 10년, DGS10) — https://fredaccount.stlouisfed.org
FRED_API_KEY=

# 한국은행 ECOS (환율·국채3년) — https://ecos.bok.or.kr Open API
ECOS_API_KEY=

# KRX 투자자 순매수용 로그인 (선택) — 이 실행환경 egress에선 KRX가 차단됨
KRX_ID=
KRX_PW=
